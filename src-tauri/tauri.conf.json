{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storiiboard",
  "version": "0.1.0",
  "identifier": "app.storiiboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storiiboard",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#EEE9DF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Video",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "binaries/ffmpeg-LICENSE.txt": "ffmpeg-LICENSE.txt",
      "binaries/ffmpeg-LICENSE.md": "ffmpeg-LICENSE.md",
      "binaries/zimg-LICENSE.txt": "zimg-LICENSE.txt",
      "binaries/dav1d-LICENSE.txt": "dav1d-LICENSE.txt",
      "binaries/ffmpeg-SOURCE.txt": "ffmpeg-SOURCE.txt"
    },
    "shortDescription": "Open-source pre-production for filmmakers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["sbd"],
        "name": "Storiiboard Project",
        "description": "Storiiboard Project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.storiiboard.project",
        "exportedType": {
          "identifier": "app.storiiboard.project",
          "conformsTo": ["public.data", "public.database"]
        }
      }
    ]
  }
}
