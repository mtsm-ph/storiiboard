{
  "name": "storiiboard-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "Storiiboard's MCP server: reads a project for an AI assistant, read-only (docs/MCP.md).",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "node ../node_modules/eslint/bin/eslint.js .",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "build": "node ../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
